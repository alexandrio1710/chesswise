# Copy this file to .env and fill in what you need. .env is gitignored —
# never commit your real webhook URL or personal settings.
# Every value below is optional; the app has sensible defaults for all of
# them except where noted.

# --- Stockfish -----------------------------------------------------------
# Only needed if auto-detection (PATH, common install dirs) doesn't find it.
# STOCKFISH_PATH=C:\path\to\stockfish.exe

# Search depth for routine per-move analysis (speed/accuracy tradeoff).
# STOCKFISH_DEPTH=15

# Search depth + number of candidate lines for puzzle generation.
# PUZZLE_DEPTH=18
# PUZZLE_TOP_LINES=3

# --- Database --------------------------------------------------------------
# Defaults to chess_tracker.db in the project root.
# DB_PATH=C:\path\to\chess_tracker.db

# --- Chess API etiquette (Lichess / Chess.com) ------------------------------
# API_MAX_RETRIES=3
# API_BACKOFF_BASE_SECONDS=1.0
# API_INTER_REQUEST_DELAY_SECONDS=0.3

# --- Your usernames (optional convenience defaults for refresh/digest) -----
# LICHESS_USERNAME=your_lichess_username
# CHESSCOM_USERNAME=your_chesscom_username

# --- Discord digest (Stage F, optional) -------------------------------------
# Create one via a Discord channel's Settings -> Integrations -> Webhooks.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy
