# Copy this file to .env and fill in what you need. .env is gitignored —
# never commit your real webhook URL or personal settings.
# Every value below is optional; the app has sensible defaults for all of
# them except where noted.

# --- Stockfish -----------------------------------------------------------
# Only needed if auto-detection (PATH, common install dirs) doesn't find it.
# STOCKFISH_PATH=C:\path\to\stockfish.exe

# Search depth for routine per-move analysis (speed/accuracy tradeoff).
# STOCKFISH_DEPTH=15

# Search depth + number of candidate lines for puzzle generation.
# PUZZLE_DEPTH=18
# PUZZLE_TOP_LINES=3

# Games analyzed in parallel during batch analysis — roughly one CPU core
# per worker. Defaults to min(4, your CPU count). Set to 1 to force
# sequential.
# ANALYSIS_WORKERS=4

# --- Database --------------------------------------------------------------
# Defaults to chess_tracker.db in the project root.
# DB_PATH=C:\path\to\chess_tracker.db

# --- Chess API etiquette (Lichess / Chess.com) ------------------------------
# API_MAX_RETRIES=3
# API_BACKOFF_BASE_SECONDS=1.0
# API_INTER_REQUEST_DELAY_SECONDS=0.3

# --- Your usernames (optional convenience defaults for refresh/digest) -----
# LICHESS_USERNAME=your_lichess_username
# CHESSCOM_USERNAME=your_chesscom_username

# --- Discord digest (Stage F, optional) -------------------------------------
# Create one via a Discord channel's Settings -> Integrations -> Webhooks.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# Per-game Discord alerts: how low accuracy has to drop, or how large a
# single blunder's eval swing has to be (in centipawns), to trigger an
# immediate alert for that game (see alerts.py). Only matters if
# DISCORD_WEBHOOK_URL is set.
# ALERT_ACCURACY_BELOW=50
# ALERT_BLUNDER_EVAL_DROP_CP=500

# Where the dashboard is reachable from — used to build a clickable game
# link in Discord alerts/digests (sent from a background thread/CLI script
# with no HTTP request of their own to read a host from). Override if
# `serve` runs on a different host/port than the default.
# BASE_URL=http://127.0.0.1:8000

# --- Lichess OAuth (Web platform, Section 1) --------------------------------
# Register an app at https://lichess.org/account/oauth/app — Lichess issues
# only a client_id, no secret (this app uses PKCE instead of a shared secret).
# LICHESS_OAUTH_CLIENT_ID=chess-mistake-tracker
# LICHESS_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/lichess/callback
# LICHESS_OAUTH_SCOPES=
# SESSION_COOKIE_NAME=cmt_session
# SESSION_TTL_DAYS=30
# Set to true once served over HTTPS in a real deployment.
# SESSION_COOKIE_SECURE=false

# --- Redis / Celery (Web platform, Section 4) -------------------------------
# Needed only for background (queued) analysis via /api/analyze/start — the
# existing synchronous CLI/`refresh` analysis path doesn't use this.
# REDIS_URL=redis://localhost:6379/0
